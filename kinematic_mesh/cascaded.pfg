; step 2, the cascaded inversion: the static data at beta = 1 throughout, the waveforms annealed; the
; slips start from the static posterior; a rise time per patch, a rupture velocity per group of
; patches, and the hypocenter, with a prior 5 km off the true one, as a catalog's might be
slipmodel:
    model = altar.models.ensemble
    model:
        case = input
        patches = 128
        psets_list = [across, parallel, risetime, rupturevelocity, hypo_strike, hypo_dip]
        psets:
            across = contiguous
            parallel = contiguous
            risetime = contiguous
            rupturevelocity = contiguous
            hypo_strike = contiguous
            hypo_dip = contiguous
            across:
                count = {slipmodel.model.patches}
                prep = preset
                prep.input_file = results/static/step_final.h5
                prep.dataset = ParameterSets/across
                prior = gaussian
                prior.mean = 0
                prior.sigma = 0.5
            parallel:
                count = {slipmodel.model.patches}
                prep = preset
                prep.input_file = results/static/step_final.h5
                prep.dataset = ParameterSets/parallel
                prior = uniform
                prior.support = (-1.0, 15.0)
                prior.reparameterize = True
            risetime:
                count = {slipmodel.model.patches}
                prior = uniform
                prior.support = (1.0, 12.0)
                prior.reparameterize = True
            rupturevelocity:
                count = 16
                prior = uniform
                prior.support = (1.0, 4.0)
                prior.reparameterize = True
            hypo_strike:
                count = 1
                prior = gaussian
                prior.mean = 121.0
                prior.sigma = 5.0
            hypo_dip:
                count = 1
                prior = gaussian
                prior.mean = 58.0
                prior.sigma = 5.0
        models:
            static = altar.models.seismic.static
            kinematic = altar.models.seismic.kinematicmesh
            static:
                cascaded = True
                case = {slipmodel.model.case}
                patches = {slipmodel.model.patches}
                psets_list = [across, parallel]
                green = static.gf.h5
                dataobs:
                    observations = 188
                    data_file = static.data.h5
                    cd_file = static.Cd.h5
            kinematic:
                case = {slipmodel.model.case}
                psets_list = [across, parallel, risetime, rupturevelocity, hypo_strike, hypo_dip]
                mesh = mesh.h5
                refine = 10
                velocity_groups = groups/velocity
                green = kinematicG.gf.h5
                dataobs:
                    observations = 8640
                    data_file = kinematicG.data.h5
                    cd_std = 5.0e-3
                Nt = 85
                dt = 1.0
    ; 40 trajectories of 25 leapfrog steps at each beta step, about 1000 leapfrog steps
    controller = altar.bayesian.catmip_hmc
    controller:
        sampler:
            leapfrog_steps = 25
        archiver = altar.bayesian.h5recorder
        archiver:
            output_dir = results/cascaded
            output_freq = 5
    rng.seed = 31
    job:
        tasks = 1
        gpus = 1
        gpuprecision = float32
        chains = 4096
        steps = 40

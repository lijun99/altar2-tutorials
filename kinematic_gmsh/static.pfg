; step 2, the static inversion: the slips from the static data alone, gps and line of sight, as a
; magnitude U(0, 15) m and a rake N(0, 20) degrees from the convergence, per patch
slipmodel:
    model = altar.models.ensemble
    model:
        case = input
        patches = 132
        polar = [magnitude, rake, parallel, across]
        psets_list = [magnitude, rake]
        psets:
            magnitude = contiguous
            rake = contiguous
            magnitude:
                count = {slipmodel.model.patches}
                prior = uniform
                prior.support = (0.0, 15.0)
                prior.reparameterize = True
            rake:
                count = {slipmodel.model.patches}
                prior = gaussian
                prior.mean = 0
                prior.sigma = 20
        models:
            static = altar.models.seismic.static
            static:
                case = {slipmodel.model.case}
                patches = {slipmodel.model.patches}
                ; the columns of the green's functions: across, then along the convergence
                psets_list = [across, parallel]
                green = static.gf.h5
                dataobs:
                    observations = 197
                    data_file = static.data.h5
                    cd_file = static.Cd.h5
    controller = altar.bayesian.catmip_hmc
    controller:
        sampler:
            leapfrog_steps = 10
        archiver = altar.bayesian.h5recorder
        archiver:
            output_dir = results/static
            output_freq = 5
    job:
        tasks = 1
        gpus = 1
        gpuprecision = float32
        chains = 4096
        steps = 20
